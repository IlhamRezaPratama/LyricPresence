{
  "manifest_version": 3,
  "name": "Spotify RPC Bridge",
  "version": "2.0.0",
  "description": "Discord Rich Presence + Live Lyrics",
  "permissions": [
    "tabs",
    "activeTab"
  ],
  "host_permissions": [
    "https://open.spotify.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}